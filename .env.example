# Copy to .env. Every value marked REQUIRED IN PRODUCTION is checked at
# startup: the API refuses to boot with NODE_ENV=production if it is
# missing or insecure.

NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://sevasetu:sevasetu@localhost:5432/sevasetu
# Exact browser origins of the customer/worker app and the admin panel.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# Number of reverse proxies in front of the API (for correct client IPs).
TRUST_PROXY_HOPS=0

# --- Secrets (REQUIRED IN PRODUCTION) -------------------------------
# Generate each with:  openssl rand -base64 32
JWT_SECRET=
PII_ENCRYPTION_KEY=
LOOKUP_HMAC_KEY=

# --- Payments: Razorpay + RazorpayX (REQUIRED IN PRODUCTION) --------
PAYMENT_PROVIDER=mock            # razorpay in production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # Dashboard → Webhooks → /api/webhooks/razorpay
RAZORPAYX_ACCOUNT_NUMBER=        # for fund-account validation and payouts

# --- SMS OTP: MSG91 (REQUIRED IN PRODUCTION) ------------------------
SMS_PROVIDER=console             # msg91 in production
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=           # DLT-approved template with an ##otp## variable
MSG91_NOTICE_TEMPLATE_ID=

# --- Masked calling: Exotel (REQUIRED IN PRODUCTION) ----------------
CALL_PROVIDER=console            # exotel in production
EXOTEL_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=                # your ExoPhone (virtual number)
EXOTEL_SUBDOMAIN=api.exotel.com

# --- Push notifications: Firebase Cloud Messaging (optional) --------
PUSH_PROVIDER=none               # fcm to enable
FCM_SERVICE_ACCOUNT_JSON=

# --- Business rules --------------------------------------------------
DEFAULT_COMMISSION_BPS=2000              # 20% (plan: 15–25%)
PAYOUT_TWO_PERSON_THRESHOLD_PAISE=5000000 # batches above ₹50,000 need 2 approvers
CHECKIN_RADIUS_M=200
GPS_FLAG_DISTANCE_M=1000
LATE_CANCEL_FEE_BPS=1000
FEATURED_PRIORITY_MINUTES=10          # featured workers see new jobs first
FEATURED_PRIORITY_URGENT_MINUTES=2
WORKER_POLICY_VERSION=2026-01
PRIVACY_POLICY_VERSION=2026-01
RECONCILIATION_HOUR_IST=2
RUN_SCHEDULER=true
